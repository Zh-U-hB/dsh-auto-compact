{
  "name": "dsh-auto-compact",
  "description": "DeepSeek Harness plugin: automatically invoke the built-in compaction engine when a session's measured context reaches a configurable absolute token threshold (default 256K)",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "scripts/manage-presets.mjs",
    "README.md",
    "README.zh.md",
    "install.sh",
    "uninstall.sh",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "test": "node --test test/unit.test.mjs test/apply.test.mjs test/client.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node --check scripts/manage-presets.mjs && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "compaction",
    "auto-compact",
    "context"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zh-U-hB/dsh-auto-compact.git"
  },
  "bugs": {
    "url": "https://github.com/Zh-U-hB/dsh-auto-compact/issues"
  },
  "homepage": "https://github.com/Zh-U-hB/dsh-auto-compact#readme"
}
